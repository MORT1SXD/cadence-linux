#!/bin/sh
set -eu

appdir=${APPDIR:-$(dirname "$(readlink -f "$0")")}
export LD_LIBRARY_PATH="$appdir/usr/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
export XDG_DATA_DIRS="$appdir/usr/share:${XDG_DATA_DIRS:-/usr/local/share:/usr/share}"
export GSETTINGS_SCHEMA_DIR="$appdir/usr/share/glib-2.0/schemas"

# The loader cache contains absolute paths. Generate it after mounting so it
# works both when the image is mounted with FUSE and when it is extracted.
cache=$(mktemp "${TMPDIR:-/tmp}/cadence-loaders.XXXXXX")
trap 'rm -f -- "$cache"' EXIT
export GDK_PIXBUF_MODULE_FILE="$cache"
"$appdir/usr/bin/gdk-pixbuf-query-loaders" "$appdir/usr/lib/cadence-loaders/libpixbufloader-svg.so" > "$cache"
"$appdir/usr/bin/cadence" "$@"
