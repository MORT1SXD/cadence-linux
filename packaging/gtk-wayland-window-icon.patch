+static gboolean
+sync_toplevel_icon (GdkWaylandToplevel *toplevel)
+{
+  GdkWaylandDisplay *display = GDK_WAYLAND_DISPLAY (gdk_surface_get_display (GDK_SURFACE (toplevel)));
+
+  if (!display->toplevel_icon_manager || !toplevel->display_server.xdg_toplevel)
+    return FALSE;
+
+  xdg_toplevel_icon_manager_v1_set_icon (display->toplevel_icon_manager,
+                                        toplevel->display_server.xdg_toplevel,
+                                        toplevel->icon);
+  return TRUE;
+}
+
+static void
+clear_toplevel_icon (GdkWaylandToplevel *toplevel)
+{
+  /* Destroy the icon before its backing buffers, as required by the protocol. */
+  g_clear_pointer (&toplevel->icon, xdg_toplevel_icon_v1_destroy);
+  g_list_free_full (toplevel->icon_surfaces, (GDestroyNotify) cairo_surface_destroy);
+  toplevel->icon_surfaces = NULL;
+}
+
+static void
+ignore_icon_buffer_release (void *data, struct wl_buffer *buffer)
+{
+}
+
+static const struct wl_buffer_listener icon_buffer_listener = {
+  ignore_icon_buffer_release,
+};
+
+static void
+set_toplevel_icon_list (GdkWaylandToplevel *toplevel,
+                        GList              *textures)
+{
+  GdkWaylandDisplay *display = GDK_WAYLAND_DISPLAY (gdk_surface_get_display (GDK_SURFACE (toplevel)));
+  gboolean had_icon = toplevel->icon != NULL;
+
+  if (!display->toplevel_icon_manager)
+    return;
+
+  clear_toplevel_icon (toplevel);
+
+  for (GList *l = textures; l; l = l->next)
+    {
+      GdkTexture *texture = l->data;
+      int size = gdk_texture_get_width (texture);
+      cairo_surface_t *surface;
+      struct wl_buffer *buffer;
+
+      /* xdg-toplevel-icon only accepts square buffers. */
+      if (size <= 0 || size != gdk_texture_get_height (texture))
+        continue;
+
+      surface = gdk_wayland_display_create_shm_surface (display, size, size,
+                                                       &GDK_FRACTIONAL_SCALE_INIT_INT (1));
+      gdk_texture_download (texture, cairo_image_surface_get_data (surface),
+                            cairo_image_surface_get_stride (surface));
+      cairo_surface_mark_dirty (surface);
+      buffer = _gdk_wayland_shm_surface_get_wl_buffer (surface);
+      wl_buffer_add_listener (buffer, &icon_buffer_listener, NULL);
+
+      if (!toplevel->icon)
+        toplevel->icon = xdg_toplevel_icon_manager_v1_create_icon (display->toplevel_icon_manager);
+      xdg_toplevel_icon_v1_add_buffer (toplevel->icon, buffer, 1);
+      toplevel->icon_surfaces = g_list_prepend (toplevel->icon_surfaces, surface);
+    }
+
+  if ((had_icon || toplevel->icon) && sync_toplevel_icon (toplevel))
+    wl_surface_commit (GDK_WAYLAND_SURFACE (toplevel)->display_server.wl_surface);
+}
